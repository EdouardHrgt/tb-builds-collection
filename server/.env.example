# Copy this file to server/.env and fill it in. Never commit the real .env (it is in .gitignore).

# Required in production: a long random string (openssl rand -hex 32). Changing it logs everyone out.
JWT_SECRET=change-me
# Production: keeps the destructive dev scripts (db:reset) from running by mistake. Leave empty in development.
NODE_ENV=production

# Public address of the site, no trailing slash. Used in reset-password emails and link previews.
APP_URL=https://sigmararsenal.xyz
PORT=3000

# Database file (default ./data/app.db, relative to the server/ folder). It must live on a persistent disk.
# DB_PATH=./data/app.db

# Number of reverse proxies in front of Node (default 1 in production: Caddy / Nginx / the host's proxy).
# TRUST_PROXY=1

# Emails (password reset, email-change notice). Leave SMTP_HOST empty in development:
# the email is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sigmar's Arsenal <no-reply@sigmararsenal.xyz>"

# Backups (npm run db:backup): folder and number of copies kept
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
