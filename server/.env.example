# Copy this file to server/.env and fill it in. Never commit the real .env (it is in .gitignore).

# Development: any value works. Production: a long random string (openssl rand -hex 32); changing it logs everyone out.
JWT_SECRET=dev-only-change-me
# Production only (keeps db:reset from running by mistake). Leave it commented in development.
# NODE_ENV=production

# Public address of the site, no trailing slash (production: https://sigmararsenal.xyz). Used in reset-password emails and link previews.
APP_URL=http://localhost:5173
PORT=3000

# Database file (default ./data/app.db, relative to the server/ folder). It must live on a persistent disk.
# DB_PATH=./data/app.db

# Number of reverse proxies in front of Node (default 1 in production: Caddy / Nginx / the host's proxy).
# TRUST_PROXY=1

# Emails (password reset, email-change notice). Leave SMTP_HOST empty in development:
# the email is printed in the server console instead.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=<your API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sigmar's Arsenal <no-reply@sigmararsenal.xyz>"

# Backups (npm run db:backup): folder and number of copies kept
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
